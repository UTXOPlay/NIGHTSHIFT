{
  "name": "@utxoplay/nightshift",
  "version": "14.2.0",
  "private": true,
  "type": "module",
  "description": "NIGHTSHIFT: World Circuit — solo racing, vehicle progression and signed Myelin replay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/UTXOPlay/NIGHTSHIFT.git"
  },
  "homepage": "https://store.utxoplay.io/games/nightshift/",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build-nightshift-v9.mjs",
    "build:native": "cargo build --release --locked --manifest-path games/nightshift-v14/native/Cargo.toml --target-dir target",
    "build:native:legacy": "cargo build --release --locked --manifest-path games/nightshift-v8/native/Cargo.toml --target-dir target",
    "start": "node host/nightshift14.mjs",
    "dev": "npm run build && node tools/dev.mjs",
    "test": "node --test tests/*.test.mjs host/*.test.mjs",
    "test:native": "cargo test --release --locked --manifest-path games/nightshift-v14/native/Cargo.toml --target-dir target",
    "test:conformance": "node tests/nightshift14-conformance.mjs",
    "test:replay": "node tests/nightshift14-signed-replay.mjs",
    "test:browser": "node tools/nightshift14-career-review.mjs",
    "test:combat": "node tools/nightshift14-combat-review.mjs",
    "test:maps": "node tools/nightshift14-presentation-review.mjs",
    "test:performance": "node tools/nightshift14-performance.mjs",
    "check:release": "node tools/check-release.mjs",
    "test:balance": "node tests/nightshift14-conformance.mjs",
    "build:native:previous": "cargo build --release --locked --manifest-path games/nightshift-v9/native/Cargo.toml --target-dir target",
    "test:conformance:previous": "node tests/nightshift9-conformance.mjs",
    "build:native:v14": "cargo build --release --locked --manifest-path games/nightshift-v14/native/Cargo.toml --target-dir target",
    "test:native:v14": "cargo test --release --locked --manifest-path games/nightshift-v14/native/Cargo.toml --target-dir target",
    "test:conformance:v14": "node tests/nightshift14-conformance.mjs",
    "test:replay:v14": "node tests/nightshift14-signed-replay.mjs",
    "test:conformance:v13": "node tests/nightshift13-conformance.mjs",
    "test:replay:v13": "node tests/nightshift13-signed-replay.mjs",
    "test:host": "node tools/nightshift14-host-review.mjs",
    "test:legacy-browser": "node tools/nightshift14-legacy-browser-review.mjs",
    "test:tactics": "node tools/nightshift14-tactics-review.mjs",
    "test:controls": "node tools/nightshift14-controls-review.mjs",
    "test:connection": "node tools/nightshift14-connection-review.mjs",
    "build:native:history": "node tools/build-legacy-runtimes.mjs",
    "test:fleet": "ALL_CARS=1 node tools/nightshift141-fleet-review.mjs",
    "test:full-race": "node tools/nightshift141-full-race-review.mjs"
  },
  "dependencies": {
    "express": "5.1.0",
    "three": "0.180.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@ckb-ccc/shell": "1.3.15",
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  }
}
