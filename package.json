{
  "name": "@utxoplay/nightshift",
  "version": "8.1.0",
  "private": true,
  "type": "module",
  "description": "NIGHTSHIFT: World Circuit \u2014 solo racing, vehicle progression and signed Myelin replay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/UTXOPlay/NIGHTSHIFT.git"
  },
  "homepage": "https://store.utxoplay.io/games/drift-run/",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build-nightshift-v8.mjs",
    "build:native": "cargo build --release --locked --manifest-path games/nightshift-v8/native/Cargo.toml --target-dir target",
    "build:native:legacy": "cargo build --release --locked --manifest-path games/nightshift-v7/native/Cargo.toml --target-dir target",
    "start": "node host/nightshift8.mjs",
    "dev": "npm run build && node tools/dev.mjs",
    "test": "node --test tests/*.test.mjs host/*.test.mjs",
    "test:native": "cargo test --release --locked --manifest-path games/nightshift-v8/native/Cargo.toml --target-dir target",
    "test:conformance": "node tests/nightshift8-conformance.mjs",
    "test:replay": "node tests/nightshift8-signed-replay.mjs",
    "test:browser": "node tools/nightshift8-acceptance.mjs",
    "test:combat": "node tools/nightshift8-combat-review.mjs",
    "test:maps": "node tools/nightshift8-map-review.mjs",
    "test:performance": "node tools/nightshift8-perf.mjs",
    "check:release": "node tools/check-release.mjs",
    "test:balance": "node tools/nightshift8-balance.mjs"
  },
  "dependencies": {
    "express": "5.1.0",
    "three": "0.180.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@ckb-ccc/shell": "1.3.15",
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  }
}
